<Window x:Class="HyperBoost.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="HyperBoost Beta" Width="1180" Height="820" MinWidth="940" MinHeight="680"
 Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel>
   <StackPanel><TextBlock Text="HYPERBOOST" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="Beta 0.3.1 · Gaming Persona complementaria a Windows 11 y NVIDIA" Foreground="#94A3B8"/></StackPanel>
   <Border DockPanel.Dock="Right" Background="#15352F" CornerRadius="16" Padding="12,6" VerticalAlignment="Center"><TextBlock Text="GPU: SOLO LECTURA" Foreground="#72F2CA" FontWeight="Bold"/></Border>
  </DockPanel>

  <Border Grid.Row="1" Margin="0,18,0,14" Background="{StaticResource Panel}" CornerRadius="10" Padding="14">
   <StackPanel>
    <TextBlock x:Name="StatusText" Text="Pulsa Analizar PC para comenzar." FontSize="16"/>
    <ProgressBar x:Name="Busy" Height="4" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="{StaticResource Accent}"/>
   </StackPanel>
  </Border>

  <TabControl Grid.Row="2" Background="{StaticResource Panel}" BorderThickness="0">
   <TabItem Header="Equipo">
    <ScrollViewer><TextBox x:Name="HardwareText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="14" Padding="18" Background="#101620" Foreground="#DCE7F5" BorderThickness="0"/></ScrollViewer>
   </TabItem>

   <TabItem Header="Diagnóstico">
    <ListBox x:Name="Findings" Background="#101620" BorderThickness="0">
     <ListBox.ItemTemplate><DataTemplate><Border Margin="7" Padding="12" Background="#192231" CornerRadius="8"><StackPanel><TextBlock Text="{Binding Severity}" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,3"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#B8C4D6"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </TabItem>

   <TabItem Header="Gaming Persona">
    <ScrollViewer Background="#101620">
     <StackPanel Margin="20">
      <TextBlock Text="GAMING PERSONA · BETA 0.3.1" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
      <TextBlock Margin="0,7,0,14" TextWrapping="Wrap" Foreground="#B8C4D6" Text="Selecciona el juego ya abierto. HyperBoost no cambia prioridad, timers, gráficos ni QoS del juego: Windows 11, Game Mode, el driver y NVIDIA App mantienen autoridad. La Persona solo reduce competencia segura alrededor del juego mientras ese PID tenga foco."/>

      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="GameProcessCombo" MinHeight="36" Margin="0,0,8,0" DisplayMemberPath="Display" SelectionChanged="GameProcessCombo_SelectionChanged" Foreground="#111827"/>
       <Button x:Name="RefreshProcessesButton" Grid.Column="1" Content="Actualizar procesos" Click="RefreshProcesses_Click"/>
      </Grid>

      <TextBlock Margin="0,18,0,7" Text="CAPA ADAPTATIVA PROPIA DE HYPERBOOST" FontWeight="Bold"/>
      <CheckBox x:Name="PersonaEcoQosCheck" IsChecked="True" Margin="2,4" Content="EcoQoS solo para sincronizadores/procesos de escritorio de la lista segura"/>
      <TextBlock Margin="24,0,0,7" TextWrapping="Wrap" Foreground="#94A3B8" Text="No se aplica a navegadores, Steam/Epic, Discord, audio, OBS, overlays, NVIDIA, anti-cheat ni periféricos. Si una app ya administra explícitamente su QoS, HyperBoost la respeta."/>

      <CheckBox x:Name="PersonaMemoryCheck" IsChecked="True" Margin="2,6,0,4" Content="Memory Priority adaptativa (5 → 4 únicamente bajo presión real de RAM)"/>
      <TextBlock Margin="24,0,0,12" TextWrapping="Wrap" Foreground="#94A3B8" Text="Solo para la misma lista segura y únicamente con ≥75% de RAM usada o menos de 6 GB disponibles. Si la app ya tiene una prioridad distinta de 5, no se modifica."/>

      <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
       <Button x:Name="StartPersonaButton" Content="Armar Gaming Persona" Click="StartPersona_Click"/>
       <Button x:Name="StopPersonaButton" Content="Detener y restaurar" Click="StopPersona_Click" Background="#334155" Foreground="White"/>
      </StackPanel>

      <Border Background="#192231" CornerRadius="8" Padding="12" Margin="0,0,0,18">
       <TextBlock x:Name="PersonaStatus" TextWrapping="Wrap" Text="Gaming Persona detenida."/>
      </Border>

      <Separator Margin="0,2,0,16"/>
      <TextBlock Text="ESCÁNER DE INTERFERENCIAS · SOLO LECTURA" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
      <TextBlock Margin="0,6,0,10" TextWrapping="Wrap" Foreground="#B8C4D6" Text="Mide CPU, I/O y memoria por proceso. No duplica el overlay de NVIDIA: su objetivo es descubrir qué proceso de Windows está compitiendo con el juego, no mostrar FPS ni telemetría de GPU."/>
      <Button x:Name="ScanInterferenceButton" Content="Medir interferencias ahora" HorizontalAlignment="Left" Click="ScanInterference_Click"/>
      <TextBox x:Name="InterferenceText" Margin="0,10,0,4" MinHeight="180" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" Padding="10" Background="#0B111A" Foreground="#DCE7F5" BorderThickness="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="Aún no se ha realizado una medición."/>

      <Border Background="#2A2115" CornerRadius="8" Padding="12" Margin="0,14,0,0">
       <TextBlock TextWrapping="Wrap" Foreground="#F6D58B" Text="Sin solapamiento: HyperBoost no modifica Game Mode/Game DVR, HAGS, optimizaciones para juegos en ventanas, gráficos, DLSS, Smooth Motion, Low Latency/Reflex, G-SYNC, límites de FPS, ShadowPlay, perfiles 3D, auto-tuning de GPU ni planes de energía."/>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>

   <TabItem Header="Qué modifica">
    <ScrollViewer Background="#101620">
     <TextBlock Padding="20" TextWrapping="Wrap" FontSize="15" Text="WINDOWS/NVIDIA: NO LOS DUPLICA&#10;Game Mode, captura/Game DVR, optimizaciones para juegos en ventanas, HAGS, plan de energía y políticas del juego quedan en Windows. DLSS, Smooth Motion, Low Latency/Reflex, G-SYNC, límites de FPS, ShadowPlay, perfiles 3D y tuning quedan en NVIDIA App/driver.&#10;&#10;GAMING PERSONA TEMPORAL&#10;Solo mientras el juego seleccionado está en primer plano, una allowlist pequeña de procesos secundarios no críticos puede pasar a EcoQoS. Si una app ya controla explícitamente su QoS, HyperBoost no la pisa. Bajo presión real de RAM, esos mismos procesos pueden bajar Memory Priority de 5 a 4. Alt+Tab restaura el estado anterior.&#10;&#10;ESCÁNER DE INTERFERENCIAS&#10;Mide CPU, working set e I/O por proceso. No muestra FPS ni telemetría GPU, por lo que no reemplaza ni duplica el overlay de NVIDIA.&#10;&#10;COMPATIBILIDAD&#10;El botón inferior de restauración solo aparece útil si existe un backup creado por una beta anterior. Beta 0.3.1 ya no escribe Game Mode, Game DVR ni planes de energía."/>
    </ScrollViewer>
   </TabItem>
  </TabControl>

  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
   <Button x:Name="ScanButton" Content="Analizar PC" Click="Scan_Click"/>
   <Button x:Name="RestoreButton" Content="Restaurar cambios de beta anterior" Click="Restore_Click" Background="#334155" Foreground="White"/>
  </StackPanel>
 </Grid>
</Window>
