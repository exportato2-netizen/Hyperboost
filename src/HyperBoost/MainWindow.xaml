<Window x:Class="HyperBoost.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="HyperBoost Beta" Width="1120" Height="760" MinWidth="900" MinHeight="640"
 Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel>
   <StackPanel><TextBlock Text="HYPERBOOST" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="Beta 0.2 · FPS y frame pacing sin sacrificar calidad ni seguridad" Foreground="#94A3B8"/></StackPanel>
   <Border DockPanel.Dock="Right" Background="#15352F" CornerRadius="16" Padding="12,6" VerticalAlignment="Center"><TextBlock Text="GPU: SOLO LECTURA" Foreground="#72F2CA" FontWeight="Bold"/></Border>
  </DockPanel>

  <Border Grid.Row="1" Margin="0,18,0,14" Background="{StaticResource Panel}" CornerRadius="10" Padding="14">
   <StackPanel>
    <TextBlock x:Name="StatusText" Text="Pulsa Analizar PC para comenzar." FontSize="16"/>
    <ProgressBar x:Name="Busy" Height="4" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="{StaticResource Accent}"/>
   </StackPanel>
  </Border>

  <TabControl Grid.Row="2" Background="{StaticResource Panel}" BorderThickness="0">
   <TabItem Header="Equipo">
    <ScrollViewer><TextBox x:Name="HardwareText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="14" Padding="18" Background="#101620" Foreground="#DCE7F5" BorderThickness="0"/></ScrollViewer>
   </TabItem>

   <TabItem Header="Diagnóstico">
    <ListBox x:Name="Findings" Background="#101620" BorderThickness="0">
     <ListBox.ItemTemplate><DataTemplate><Border Margin="7" Padding="12" Background="#192231" CornerRadius="8"><StackPanel><TextBlock Text="{Binding Severity}" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,3"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#B8C4D6"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </TabItem>

   <TabItem Header="Boost por juego">
    <ScrollViewer Background="#101620">
     <StackPanel Margin="20">
      <TextBlock Text="BOOST DE SESIÓN POR PROCESO" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
      <TextBlock Margin="0,7,0,14" TextWrapping="Wrap" Foreground="#B8C4D6" Text="Selecciona el juego ya abierto. HyperBoost pedirá a Windows HighQoS para ese proceso, evitando que la heurística de ahorro reduzca su velocidad de ejecución. No inyecta DLL, no modifica archivos del juego y no toca la GPU."/>

      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="GameProcessCombo" MinHeight="36" Margin="0,0,8,0" DisplayMemberPath="Display" SelectionChanged="GameProcessCombo_SelectionChanged" Foreground="#111827"/>
       <Button x:Name="RefreshProcessesButton" Grid.Column="1" Content="Actualizar procesos" Click="RefreshProcesses_Click"/>
      </Grid>

      <CheckBox x:Name="BoostPriorityCheck" Margin="2,16,0,4" Content="Prioridad Above Normal (opcional; solo si el juego parte en prioridad Normal)"/>
      <TextBlock Margin="24,0,0,7" TextWrapping="Wrap" Foreground="#94A3B8" Text="Puede ayudar en escenarios CPU-bound, pero se evita prioridad High/Realtime para no perjudicar audio, entrada ni procesos del sistema."/>

      <CheckBox x:Name="HonorTimersCheck" Margin="2,6,0,4" Content="Respetar solicitudes de resolución de temporizador del juego (opcional)"/>
      <TextBlock Margin="24,0,0,12" TextWrapping="Wrap" Foreground="#94A3B8" Text="Puede mejorar frame pacing en algunos motores; aumenta actividad/consumo y no garantiza más FPS promedio."/>

      <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
       <Button x:Name="StartBoostButton" Content="Iniciar boost de sesión" Click="StartBoost_Click"/>
       <Button x:Name="StopBoostButton" Content="Detener y restaurar" Click="StopBoost_Click" Background="#334155" Foreground="White"/>
      </StackPanel>

      <Border Background="#192231" CornerRadius="8" Padding="12" Margin="0,0,0,14">
       <TextBlock x:Name="BoostStatus" TextWrapping="Wrap" Text="Sin boost activo."/>
      </Border>

      <Separator Margin="0,4,0,14"/>
      <TextBlock Text="OTRA VÍA SEGURA: OPTIMIZACIONES PARA JUEGOS EN VENTANAS" FontWeight="Bold"/>
      <TextBlock Margin="0,6,0,8" TextWrapping="Wrap" Foreground="#B8C4D6" Text="Windows 11 puede usar el modelo flip moderno para juegos DirectX 10/11 en ventana o sin bordes, reduciendo latencia sin bajar resolución ni calidad. HyperBoost abre la página oficial de Configuración para que lo controles tú."/>
      <Button Content="Abrir Configuración de gráficos de Windows" HorizontalAlignment="Left" Click="OpenGraphics_Click"/>

      <Border Background="#2A2115" CornerRadius="8" Padding="12" Margin="0,18,0,0">
       <TextBlock TextWrapping="Wrap" Foreground="#F6D58B" Text="Seguridad: HyperBoost no desactiva Defender, Integridad de memoria/VBS, Secure Boot, firewall, mitigaciones, servicios críticos ni anti-cheat. Si Windows o el juego bloquean un ajuste de proceso, HyperBoost no intenta evadir esa protección."/>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>

   <TabItem Header="Qué modifica">
    <ScrollViewer Background="#101620">
     <TextBlock Padding="20" TextWrapping="Wrap" FontSize="15" Text="PERFIL SEGURO&#10;Activa Game Mode y desactiva la captura de juegos en segundo plano. Antes de escribir, guarda una copia local; verifica cada escritura y revierte automáticamente si algo falla. Ya no fuerza el plan Alto rendimiento global.&#10;&#10;BOOST DE SESIÓN&#10;Solo sobre el proceso que eliges: usa APIs documentadas de Windows para controlar power throttling/QoS. De forma opcional puede usar prioridad Above Normal y respetar solicitudes de temporizador. Guarda el estado original exacto y lo restaura al detener el boost; al cerrar el juego, estos cambios de proceso desaparecen.&#10;&#10;NUNCA MODIFICA&#10;GPU, controlador, gráficos, resolución, perfiles NVIDIA/AMD, clocks, voltaje, potencia, ventiladores, DLSS, FSR, XeSS, Frame Generation, V-Sync, G-Sync, Reflex ni límites de FPS. Tampoco aplica BIOS, EXPO/XMP, Curve Optimizer, HPET/BCD, core parking, Defender, VBS, Integridad de memoria, Secure Boot o firewall."/>
    </ScrollViewer>
   </TabItem>
  </TabControl>

  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
   <Button x:Name="ScanButton" Content="Analizar PC" Click="Scan_Click"/>
   <Button x:Name="ApplyButton" Content="Aplicar perfil seguro" Click="Apply_Click" IsEnabled="False"/>
   <Button x:Name="RestoreButton" Content="Restaurar cambios" Click="Restore_Click" Background="#334155" Foreground="White"/>
  </StackPanel>
 </Grid>
</Window>
