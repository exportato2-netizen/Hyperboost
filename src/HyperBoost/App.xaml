<Application x:Class="HyperBoost.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Bg" Color="#0B0F17"/>
  <SolidColorBrush x:Key="Panel" Color="#141B27"/>
  <SolidColorBrush x:Key="Accent" Color="#63E6BE"/>
  <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="14,9"/><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#07110E"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E7EDF7"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E7EDF7"/><Setter Property="FontSize" Value="14"/></Style>
 </Application.Resources>
</Application>
